# Copy this file to `.env` and fill in the key.  `.env` is git-ignored (repo .gitignore); never commit a real key.
# Keys: https://openrouter.ai/keys

OPENROUTER_API_KEY=

# Model used when --model is omitted. Any OpenRouter slug works; list them with:
#   python common.py --model anthropic/claude-sonnet-5 --model openai/gpt-5.6-luna
DEFAULT_MODEL=openai/gpt-6-luna

# Optional
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=afd-checklist
